@startuml
' Palette: sequence; based on the Visual Paradigm guide samples (see README).
' Interaction: Trợ lý tài liệu cá nhân
skinparam defaultFontColor #111111
skinparam ArrowColor #222222
skinparam ActorBackgroundColor #7ACFF5
skinparam ActorBorderColor #222222
skinparam NoteBackgroundColor #FFF9D9
skinparam NoteBorderColor #555555
skinparam ParticipantBackgroundColor #7ACFF5
skinparam ParticipantBorderColor #222222
skinparam LifeLineBackgroundColor #7ACFF5
skinparam LifeLineBorderColor #222222
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #222222
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam roundcorner 10
hide footbox
autonumber
autoactivate on

actor Student
participant ":Web" as Web
participant ":Java Backend" as Java
participant ":Single Agent" as Agent
participant ":AI Tools" as Tools
participant ":pgvector (ai)" as DB
participant ":Model Provider" as LLM

Student -> Web : Chọn Personal PDF và gửi yêu cầu tự nhiên
Web -> Java : POST /student/chat/conversations/{id}/messages
Java -> Java : Kiểm owner, READY, snapshot/version
alt Không được phép
  Java --> Web : Lỗi access theo contract
else Scope hợp lệ
  Java -> Agent : POST /internal/v1/personal-assistant/runs
  Agent -> Agent : Nhận diện capability và lập tool args
  alt Thiếu tham số bắt buộc
    Agent --> Java : NEEDS_CLARIFICATION + missingFields
  else Đủ tham số
    Agent -> Tools : ask_document / summarize_document / generate_quiz
    Tools -> LLM : Embed query cùng index version
    LLM --> Tools : Query vector
    Tools -> DB : Retrieval có filter authorized scope
    DB --> Tools : Evidence theo trang
    alt Không đủ evidence
      Tools --> Agent : NO_EVIDENCE
    else Có evidence
      Tools -> LLM : Evidence + output schema
      LLM --> Tools : Answer / Summary / QuizDraft
      Tools -> Tools : Validate schema và grounding
      Tools --> Agent : Structured result + page citations
    end
    Agent --> Java : AssistantResponse
  end
  Java -> Java : Revalidate; lưu message hoặc Quiz REVIEW_REQUIRED
  Java --> Web : AssistantResponse
  Web --> Student : Nội dung, citation, câu hỏi bổ sung hoặc Quiz draft
end
return Hoàn tất tương tác
@enduml
