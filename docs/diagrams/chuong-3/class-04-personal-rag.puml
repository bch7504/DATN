@startuml
' Hình 3.4 - Thiết kế lớp Personal Document Assistant.
' Bố cục một mặt phẳng: View ở trên, Control ở giữa, Entity/DTO ở dưới.
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #111111
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #000000
skinparam ClassBorderColor #000000
skinparam ClassFontColor #111111
skinparam ClassAttributeFontColor #111111
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #FFFFFF
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam classAttributeIconSize 0
skinparam nodesep 28
skinparam ranksep 52
hide circle
top to bottom direction

class PersonalDocumentsPage <<view>> {
  +loadDocuments(): PersonalDocument[]
  +selectDocuments(ids: UUID[]): void
  +openAssistant(): void
}
class PersonalAssistantPanel <<view>> {
  +submitPrompt(message: String): void
  +showAnswer(response: AssistantResponse): void
  +showNoEvidence(): void
}
class CitationDrawer <<view>> {
  +open(citation: PageCitation): void
}
class QuizDraftReview <<view>> {
  +showDraft(draft: QuizDraft): void
  +acceptQuiz(quizId: UUID): void
  +rejectQuiz(quizId: UUID): void
}

class PersonalAssistantController <<controller>> {
  +postMessage(conversationId: UUID, body: MessageRequest): AssistantResponse
}
class PersonalAssistantService <<control>> {
  +run(studentId: UUID, conversationId: UUID, request: MessageRequest): AssistantResponse
}
class ConversationScopeService <<control>> {
  +loadAuthorizedSnapshot(studentId: UUID, conversationId: UUID): AuthorizedScope
  +validateResult(scope: AuthorizedScope, result: AssistantResponse): void
}
class AiClient <<adapter>> {
  +runAssistant(request: InternalAssistantRequest): AssistantResponse
}
class SingleOrchestratorAgent <<control>> {
  +run(request: InternalAssistantRequest): AssistantResponse
  -selectTool(message: String): ToolName
}
class AskDocumentTool <<control>> {
  +execute(args: AskArgs, scope: AuthorizedScope): AnswerResult
}
class SummarizeDocumentTool <<control>> {
  +execute(args: SummaryArgs, scope: AuthorizedScope): SummaryResult
}
class GenerateQuizTool <<control>> {
  +execute(args: QuizArgs, scope: AuthorizedScope): QuizDraft
}
class ScopedRetriever <<control>> {
  +search(scope: AuthorizedScope, query: String): EvidenceSet
}
class GroundingValidator <<control>> {
  +validate(result: GeneratedResult, evidence: EvidenceSet): ValidationResult
}

class Student <<entity>> {
  -id: UUID
  -email: String
  -status: UserStatus
}
class PersonalDocument <<entity>> {
  -id: UUID
  -ownerId: UUID
  -version: Integer
  -processingStatus: ProcessingStatus
}
class ChatConversation <<entity>> {
  -id: UUID
  -studentId: UUID
  -status: ConversationStatus
}
class ConversationDocument <<entity>> {
  -conversationId: UUID
  -documentId: UUID
  -documentVersion: Integer
}
class ChatMessage <<entity>> {
  -id: UUID
  -role: MessageRole
  -capability: Capability
  -answerStatus: AnswerStatus
}
class DocumentIndex <<entity>> {
  -documentId: UUID
  -documentVersion: Integer
  -status: IndexStatus
}
class DocumentChunk <<entity>> {
  -pageNumber: Integer
  -chunkIndex: Integer
  -embedding: Vector[1024]
}
class AgentRun <<entity>> {
  -requestId: String
  -selectedTool: ToolName
  -status: RunStatus
}
class MessageRequest <<DTO>> {
  +message: String
  +selectedDocumentIds: UUID[1..10]
}
class AssistantResponse <<DTO>> {
  +status: AssistantStatus
  +capability: Capability
  +answer: String?
  +quizDraft: QuizDraft?
  +citations: PageCitation[]
}
class PageCitation <<DTO>> {
  +documentId: UUID
  +pageNumber: Integer
  +excerpt: String
}
class QuizDraft <<DTO>> {
  +questions: McqSingleQuestion[]
}

' View navigation and View-to-Control dependencies.
PersonalDocumentsPage --> PersonalAssistantPanel
PersonalAssistantPanel --> CitationDrawer
PersonalAssistantPanel --> QuizDraftReview
PersonalAssistantPanel ..> MessageRequest
PersonalAssistantPanel ..> PersonalAssistantController
CitationDrawer ..> PageCitation
QuizDraftReview ..> QuizDraft

' Control flow.
PersonalAssistantController ..> PersonalAssistantService
PersonalAssistantService ..> ConversationScopeService
PersonalAssistantService ..> AiClient
AiClient ..> SingleOrchestratorAgent : internal HTTP
SingleOrchestratorAgent ..> AskDocumentTool
SingleOrchestratorAgent ..> SummarizeDocumentTool
SingleOrchestratorAgent ..> GenerateQuizTool
AskDocumentTool ..> ScopedRetriever
SummarizeDocumentTool ..> ScopedRetriever
GenerateQuizTool ..> ScopedRetriever
ScopedRetriever ..> GroundingValidator

' Entity associations, aggregation and composition.
Student "1" -- "0..*" PersonalDocument : owns
Student "1" -- "0..*" ChatConversation
ChatConversation "1" *-- "1..*" ConversationDocument
PersonalDocument "1" -- "0..*" ConversationDocument
ChatConversation "1" *-- "0..*" ChatMessage
PersonalDocument "1" -- "1" DocumentIndex
DocumentIndex "1" *-- "1..*" DocumentChunk
ChatConversation "1" -- "0..*" AgentRun
AssistantResponse "1" *-- "0..*" PageCitation
AssistantResponse "1" o-- "0..1" QuizDraft

' Control-to-Entity dependencies.
ConversationScopeService ..> Student
ConversationScopeService ..> PersonalDocument
ConversationScopeService ..> ChatConversation
PersonalAssistantService ..> ChatMessage
PersonalAssistantService ..> AssistantResponse
ScopedRetriever ..> DocumentIndex
ScopedRetriever ..> DocumentChunk
SingleOrchestratorAgent ..> AgentRun

note right of SingleOrchestratorAgent
  Single Agent chỉ chọn một công cụ trong danh sách cho phép.
  Prompt không được mở rộng phạm vi tài liệu
  hoặc thay đổi quy tắc Quiz.
end note

note right of ScopedRetriever
  Chỉ tìm trong Personal PDF thuộc Student
  và đúng phiên bản đã chọn.
  Thiếu bằng chứng thì trả NO_EVIDENCE.
end note
@enduml
