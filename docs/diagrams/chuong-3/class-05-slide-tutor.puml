@startuml
' Palette: class; black-and-white View-DAO-Entity report style.
' Hình 3.5 - Thiết kế lớp Course Material Tutor.
' Bố cục một mặt phẳng: View ở trên, DAO ở giữa, Entity ở dưới.
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #111111
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #000000
skinparam ClassBorderColor #000000
skinparam ClassFontColor #111111
skinparam ClassAttributeFontColor #111111
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #FFFFFF
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam classAttributeIconSize 0
skinparam nodesep 28
skinparam ranksep 52
hide circle
top to bottom direction

class CourseMaterialLibraryView <<view>> {
  +loadMaterials(): CourseMaterial[]
  +openSlide(documentId: UUID): void
  +downloadReference(documentId: UUID): void
}
class SlideViewerView <<view>> {
  +showPage(pageNumber: Integer): void
  +selectText(): String
  +toggleTutor(): void
  +toggleNotes(): void
}
class AiTutorView <<view>> {
  +open(documentId: UUID, pageNumber: Integer): void
  +ask(question: String): void
  +showAnswer(response: AnswerResponse): void
  +openCitation(citation: PageCitation): void
}
class PageNoteView <<view>> {
  +loadNote(pageNumber: Integer): void
  +saveNote(content: String): void
}

class StudentMaterialDAO <<DAO>> {
  +listMaterials(studentId: UUID): CourseMaterial[]
  +renderSlide(documentId: UUID, pageNumber: Integer): PageImage
  +getTextLayer(documentId: UUID, pageNumber: Integer): TextLayer
}
class CourseMaterialTutorDAO <<DAO>> {
  +ask(documentId: UUID, pageNumber: Integer, body: PageQuestion): AnswerResponse
}
class PageNoteDAO <<DAO>> {
  +get(documentId: UUID, pageNumber: Integer): PageNote
  +save(documentId: UUID, pageNumber: Integer, body: SaveNoteRequest): PageNote
}
class MaterialAccessDAO <<DAO>> {
  +authorizeView(studentId: UUID, documentId: UUID, pageNumber: Integer): PageScope
  +authorizeTutor(studentId: UUID, documentId: UUID, pageNumber: Integer): PageScope
}
class TutorConversationDAO <<DAO>> {
  +ask(studentId: UUID, documentId: UUID, pageNumber: Integer, question: String): AnswerResponse
}
class AiGatewayDAO <<DAO>> {
  +askCourseMaterial(scope: PageScope, question: String): AnswerResponse
}
class TutorPipelineDAO <<DAO>> {
  +run(scope: PageScope, question: String): AnswerResponse
}
class DocumentIndexDAO <<DAO>> {
  +search(scope: PageScope, query: String): EvidenceSet
}
class GroundingValidationDAO <<DAO>> {
  +validate(answer: GeneratedAnswer, evidence: EvidenceSet): ValidationResult
}

class Student <<entity>> {
  -id: UUID
  -status: UserStatus
}
class CourseOffering <<entity>> {
  -id: UUID
  -status: OfferingStatus
}
class CourseEnrollment <<entity>> {
  -studentId: UUID
  -courseOfferingId: UUID
  -status: EnrollmentStatus
}
class CourseMaterial <<entity>> {
  -id: UUID
  -ownerId: UUID
  -materialType: MaterialType
  -version: Integer
  -processingStatus: ProcessingStatus
}
class DocumentPublication <<entity>> {
  -documentId: UUID
  -courseOfferingId: UUID
  -status: PublicationStatus
}
class DocumentPage <<entity>> {
  -documentId: UUID
  -pageNumber: Integer
}
class PageNote <<entity>> {
  -studentId: UUID
  -documentId: UUID
  -pageNumber: Integer
  -content: Text
}
class LearningProgress <<entity>> {
  -studentId: UUID
  -documentId: UUID
  -lastPage: Integer
  -progressPercent: Decimal
}
class DocumentIndex <<entity>> {
  -documentId: UUID
  -documentVersion: Integer
  -status: IndexStatus
}
class DocumentChunk <<entity>> {
  -pageNumber: Integer
  -chunkIndex: Integer
  -embedding: Vector[1024]
}
class PageQuestion <<entity>> {
  +question: String
}
class PageScope <<entity>> {
  +documentId: UUID
  +documentVersion: Integer
  +courseOfferingId: UUID
  +currentPage: Integer
  +allowedPageNumbers: Integer[]
}
class AnswerResponse <<entity>> {
  +status: AnswerStatus
  +answer: String?
  +citations: PageCitation[]
}
class PageCitation <<entity>> {
  +documentId: UUID
  +pageNumber: Integer
  +excerpt: String
}

' Giữ ba vùng thị giác như mẫu: View trên, DAO giữa, Entity dưới.
CourseMaterialLibraryView -[hidden]right- SlideViewerView
SlideViewerView -[hidden]right- AiTutorView
AiTutorView -[hidden]right- PageNoteView
StudentMaterialDAO -[hidden]right- CourseMaterialTutorDAO
CourseMaterialTutorDAO -[hidden]right- PageNoteDAO
PageNoteDAO -[hidden]right- MaterialAccessDAO
MaterialAccessDAO -[hidden]right- TutorConversationDAO
AiGatewayDAO -[hidden]right- TutorPipelineDAO
TutorPipelineDAO -[hidden]right- DocumentIndexDAO
DocumentIndexDAO -[hidden]right- GroundingValidationDAO
CourseMaterialLibraryView -[hidden]down- StudentMaterialDAO
StudentMaterialDAO -[hidden]down- AiGatewayDAO
AiGatewayDAO -[hidden]down- Student

' View navigation and View-to-DAO dependencies.
CourseMaterialLibraryView --> SlideViewerView
SlideViewerView --> AiTutorView
SlideViewerView --> PageNoteView
CourseMaterialLibraryView ..> StudentMaterialDAO
SlideViewerView ..> StudentMaterialDAO
AiTutorView ..> CourseMaterialTutorDAO
AiTutorView ..> PageQuestion
PageNoteView ..> PageNoteDAO

' DAO flow.
StudentMaterialDAO ..> MaterialAccessDAO
CourseMaterialTutorDAO ..> TutorConversationDAO
TutorConversationDAO ..> MaterialAccessDAO
TutorConversationDAO ..> AiGatewayDAO
PageNoteDAO ..> MaterialAccessDAO
AiGatewayDAO ..> TutorPipelineDAO : internal HTTP
TutorPipelineDAO ..> DocumentIndexDAO
TutorPipelineDAO ..> GroundingValidationDAO

' Entity associations, aggregation and composition.
Student "1" -- "0..*" CourseEnrollment
CourseOffering "1" -- "0..*" CourseEnrollment
CourseOffering "1" o-- "0..*" DocumentPublication
CourseMaterial "1" -- "0..*" DocumentPublication
CourseMaterial "1" *-- "1..*" DocumentPage
Student "1" -- "0..*" PageNote
CourseMaterial "1" -- "0..*" PageNote
Student "1" -- "0..*" LearningProgress
CourseMaterial "1" -- "0..*" LearningProgress
CourseMaterial "1" -- "1" DocumentIndex
DocumentIndex "1" *-- "1..*" DocumentChunk
AnswerResponse "1" *-- "0..*" PageCitation

' DAO-to-Entity dependencies.
MaterialAccessDAO ..> CourseEnrollment
MaterialAccessDAO ..> DocumentPublication
MaterialAccessDAO ..> CourseMaterial
MaterialAccessDAO ..> PageScope
StudentMaterialDAO ..> DocumentPage
PageNoteDAO ..> PageNote
StudentMaterialDAO ..> LearningProgress
DocumentIndexDAO ..> DocumentIndex
DocumentIndexDAO ..> DocumentChunk
TutorConversationDAO ..> AnswerResponse

note right of MaterialAccessDAO
  Viewer và Tutor chỉ dùng SLIDE_PDF đã công bố
  cho Student có enrollment APPROVED.
  REFERENCE_PDF chỉ được tải xuống.
end note

note right of TutorPipelineDAO
  Ưu tiên trang đang xem trong phạm vi được cấp quyền.
  Thiếu bằng chứng trả NO_EVIDENCE;
  trích dẫn phải đúng trang PDF.
end note
@enduml
