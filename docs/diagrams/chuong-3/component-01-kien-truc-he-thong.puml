@startuml
' Palette: architecture; layered platform form based on the supplied reference.
' Monochrome: true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #000000
skinparam ArrowColor #000000
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
skinparam roundcorner 12
skinparam PackageStyle rectangle
skinparam PackagePadding 34
skinparam RectangleBorderColor #000000
skinparam RectangleBackgroundColor #FFFFFF
skinparam ComponentBorderColor #000000
skinparam ComponentBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam StorageBorderColor #000000
skinparam StorageBackgroundColor #FFFFFF
skinparam CloudBorderColor #000000
skinparam CloudBackgroundColor #FFFFFF
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
top to bottom direction

actor "Student / Teacher / Admin" as user

rectangle "StudyFlow Platform" as platform {
  component "Next.js" as web

  rectangle "Backend services" as backend {
    component "Spring Boot" as java
    component "FastAPI" as ai
  }

  rectangle "Platform data & file storage" as data {
    database "PostgreSQL" as appdb
    database "PostgreSQL + pgvector" as aidb
    storage "Object Storage" as storage
  }

  web -down-> java : REST /api/v1
  java -down-> ai : Internal API\nauthorized scope
  java -down-> appdb
  ai -down-> aidb
  java -down-> storage : metadata / signed URL
  ai -down-> storage : đọc PDF theo scope

  appdb -[hidden]right-> aidb
  aidb -[hidden]right-> storage
}

cloud "OpenRouter" as model

user -down-> web
storage -[hidden]down-> model
ai -down-> model : HTTPS
@enduml
