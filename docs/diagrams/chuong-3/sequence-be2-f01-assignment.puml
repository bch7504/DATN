@startuml
' Palette: sequence; Visual Paradigm-style lifelines, activations and fragments.
' Interaction: BE2-F01 - Giao bài và nộp bài
skinparam defaultFontColor #111111
skinparam ArrowColor #222222
skinparam ActorBackgroundColor #7ACFF5
skinparam ActorBorderColor #222222
skinparam ParticipantBackgroundColor #7ACFF5
skinparam ParticipantBorderColor #222222
skinparam LifeLineBackgroundColor #7ACFF5
skinparam LifeLineBorderColor #222222
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #222222
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam roundcorner 10
hide footbox
autonumber
autoactivate on

actor "Giảng viên" as Teacher
participant ":Web" as Web
participant ":Java Backend" as Java
database ":CSDL" as DB
participant ":Thông báo" as Notice
actor "Sinh viên" as Student

Teacher -> Web : Nhập bài tập, hạn nộp và tệp đính kèm
Web -> Java : Tạo bản nháp
Java -> DB : Kiểm tra chủ lớp; lưu DRAFT
DB --> Java : Bài tập đã lưu
Java --> Web : Hiển thị bản nháp
Teacher -> Web : Công bố bài tập
Web -> Java : Yêu cầu công bố
Java -> DB : Chuyển PUBLISHED
Java -> Notice : Thông báo bài mới
Notice -> Student : Gửi cho Sinh viên đã được duyệt

opt Gần hạn và chưa nộp
  Java -> DB : Tìm người chưa nộp; chống nhắc trùng
  Java -> Notice : Tạo nhắc hạn
  Notice -> Student : Gửi nhắc trước hạn
end

Student -> Web : Nộp văn bản, ảnh hoặc tệp
Web -> Java : Gửi bài nộp
Java -> DB : Kiểm quyền; lưu bài hiện tại
alt Nộp lại được phép
  Java -> DB : Thay nội dung và tệp cũ
else Không hợp lệ hoặc đã đóng
  Java --> Web : Báo lý do từ chối
end
DB --> Java : Thời điểm và trạng thái nộp
Java --> Web : Trả bài nộp hiện tại

Teacher -> Web : Xem tình trạng sau hạn
Web -> Java : Yêu cầu tổng hợp bài nộp
Java -> DB : Đối chiếu danh sách lớp và bài nộp
DB --> Java : Đúng hạn / muộn / chưa nộp
Java --> Web : Số lượng và danh sách cụ thể
@enduml
