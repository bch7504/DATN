@startuml
' Palette: architecture; clean enterprise container layout.
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #1F2937
skinparam ArrowColor #64748B
skinparam ArrowThickness 1
skinparam RectangleBorderColor #94A3B8
skinparam RectangleBackgroundColor white
skinparam NoteBackgroundColor #F8FAFC
skinparam NoteBorderColor #94A3B8
skinparam PackageStyle rectangle
skinparam PackageBorderColor #94A3B8
skinparam PackageBackgroundColor white
skinparam PackagePadding 28
skinparam roundcorner 10
skinparam nodesep 32
skinparam ranksep 42
left to right direction

rectangle "Learning Platform" as PLATFORM #FFFFFF {
  rectangle "Course Materials" as COURSE #FFFFFF {
    rectangle "Teacher công bố\nPPTX / PDF" as TEACHER #F8FAFC
    rectangle "Student được duyệt\nXem PPTX / tải PDF" as STUDENT #F1F5F9
    TEACHER -down-> STUDENT
  }

  rectangle "Personal Workspace" as PERSONAL #FFFFFF {
    rectangle "Personal PDF\ncủa Student" as PDF #F8FAFC
    rectangle "Tạo Quiz bằng prompt\nReview trước khi làm" as QUIZ #F0F7FF
    rectangle "Hỏi đáp RAG\ncitation theo trang" as RAG #F0F7FF
    PDF -down-> QUIZ
    PDF -down-> RAG
  }

  rectangle "Learning Services" as SERVICES #FFFFFF {
    rectangle "Slide Viewer\nNote / Slide Tutor" as SLIDE #F0F7FF
    rectangle "Java chấm Quiz\nCâu sai → trang nguồn" as SCORE #F0FDF4
    SLIDE -[hidden]down-> SCORE
  }

  rectangle "Student Progress" as PROGRESS #FFFFFF {
    rectangle "Dashboard\nTiến độ / Streak / Goal" as DASHBOARD #F8FAFC
    rectangle "Kế hoạch & Lịch\nStudent chủ động lập" as PLAN #FFFBEA
    DASHBOARD -[hidden]down-> PLAN
  }

  STUDENT -right-> SLIDE : chỉ PPTX
  QUIZ -right-> SCORE : đã accept
  SLIDE -right-> DASHBOARD : sự kiện xem slide
  SCORE -right-> DASHBOARD : hoàn tất Quiz

  STUDENT -[hidden]down-> PDF
  COURSE -[hidden]down-> PERSONAL
  COURSE -[hidden]right-> SERVICES
  PERSONAL -[hidden]right-> SERVICES
  SERVICES -[hidden]right-> PROGRESS

  note right of PLAN
  Không tự động lập kế hoạch bằng AI.
  RAG và tạo Quiz là hai chức năng độc lập.
  end note
}
@enduml
