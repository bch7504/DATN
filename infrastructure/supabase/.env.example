# Public Supabase template. Never fill real values into this tracked file.
# Copy to E:/DATN/.env.supabase (or <repository>/.env.supabase on another machine).
# Only an explicitly authorized tool may read that private file.
# Migration input only: these SUPABASE_DB_* names are not runtime datasource settings.
SUPABASE_DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.bcrqhbrdkzwdasczewxp
SUPABASE_DB_PASSWORD=

STORAGE_ENABLED=true
STORAGE_ENDPOINT=https://bcrqhbrdkzwdasczewxp.storage.supabase.co/storage/v1/s3
STORAGE_REGION=ap-southeast-2
STORAGE_BUCKET=studyflow-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Runtime role passwords are generated/provisioned during migration, not the admin password.
# Java runtime: DATABASE_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require&currentSchema=app
# Java runtime: DATABASE_USERNAME=studyflow_app.<project-ref>
# Java runtime: DATABASE_PASSWORD=<app-role-password>
# Python runtime: AI_DATABASE_URL=postgresql+psycopg://studyflow_ai.<project-ref>:<url-encoded-ai-role-password>@<pooler-host>:5432/postgres?sslmode=require
# Python role search_path must include ai and the schema containing pgvector.
# Keep credentials server-side; Next.js still only uses NEXT_PUBLIC_API_URL for Java.
# Local runtimes on shared data must disable local account/seed bootstraps.
