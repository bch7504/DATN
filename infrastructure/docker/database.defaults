# Non-secret local defaults used explicitly by scripts/database.ps1.
# Keeping this separate prevents Docker Compose from auto-loading the repository .env.
POSTGRES_PORT=5433
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
STORAGE_PORT=8333
STORAGE_BUCKET=studyflow-documents
STORAGE_ACCESS_KEY=studyflow_storage_local_access
STORAGE_SECRET_KEY=studyflow_storage_local_secret
