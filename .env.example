# StudyFlow local environment template.
# Copy this file to .env locally. Local database values below deliberately match
# scripts/database.ps1 and the Docker volume created by this repository.
# Never expose backend, AI, database or storage credentials with NEXT_PUBLIC_*.

# Next.js Web — public browser configuration
NEXT_PUBLIC_API_URL=http://localhost:8088/api/v1
# Fixture UI is available only when this is explicitly true.
NEXT_PUBLIC_DEMO_MODE=false

# Java Spring Boot — public API and system of record
SPRING_PROFILES_ACTIVE=local
POSTGRES_PORT=5433
POSTGRES_ADMIN_PASSWORD=studyflow_admin_local_only
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/studyflow?currentSchema=app
DATABASE_USERNAME=studyflow_app
DATABASE_PASSWORD=studyflow_app_local_only
JWT_SECRET=studyflow-local-jwt-secret-minimum-32-characters
SERVER_PORT=8088
STUDYFLOW_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STUDYFLOW_ALLOWED_EMAIL_DOMAIN=stu.ptit.edu.vn
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=local
MAIL_PASSWORD=local
MAIL_FROM=no-reply@studyflow.local
AI_SERVICE_URL=http://127.0.0.1:8001
# Must be identical to INTERNAL_SERVICE_TOKEN and contain at least 16 characters.
AI_SERVICE_TOKEN=studyflow-local-ai-token
# Java creates the Python HTTP client only when this flag is true.
AI_SERVICE_ENABLED=true
AI_CONNECT_TIMEOUT=3s
AI_READ_TIMEOUT=45s
# Development-only: permit signed HTTP URLs only on localhost/127.0.0.1/::1.
# Keep false in staging and production, where signed document URLs must use HTTPS.
AI_ALLOW_INSECURE_LOCAL_STORAGE_URL=true
# Java scans pending/indexing PDF jobs at this fixed delay in milliseconds.
AI_DOCUMENT_SCAN_DELAY=10000

# Python FastAPI/worker — internal AI service
APP_ENVIRONMENT=development
# Must have the same value as AI_SERVICE_TOKEN above.
INTERNAL_SERVICE_TOKEN=studyflow-local-ai-token
AI_DATABASE_PASSWORD=studyflow_ai_local_only
AI_DATABASE_URL=postgresql+psycopg://studyflow_ai:studyflow_ai_local_only@127.0.0.1:5433/studyflow?connect_timeout=5&options=-csearch_path%3Dai%2Cpublic
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Paste the real key only into .env. Never commit that file.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-5.6-luna
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_RETRY_BASE_SECONDS=5
AI_WORKER_POLL_SECONDS=2

# S3-compatible Object Storage — used through server-side services only
# Start the local service with: .\scripts\storage.ps1 start
STORAGE_ENABLED=true
STORAGE_ENDPOINT=http://127.0.0.1:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=studyflow-documents
STORAGE_ACCESS_KEY=studyflow_storage_local_access
STORAGE_SECRET_KEY=studyflow_storage_local_secret

# Vector search uses the pgvector extension in the PostgreSQL database above.
