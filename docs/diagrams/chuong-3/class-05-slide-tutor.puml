@startuml
' Palette: class; based on the Visual Paradigm guide samples (see README).
skinparam defaultFontColor #111111
skinparam ArrowColor #222222
skinparam NoteBackgroundColor #FFF9D9
skinparam NoteBorderColor #555555
hide circle
skinparam ClassBackgroundColor #7ACFF5
skinparam ClassBorderColor #222222
skinparam ClassHeaderBackgroundColor #7ACFF5
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam nodesep 30
skinparam ranksep 40
top to bottom direction

class CourseMaterialTutorController <<Java boundary>> {
  +ask(documentId: UUID, pageNumber: Integer, body: PageQuestion): AnswerResponse
}
class PageQuestion <<DTO>> {
  +question: String
}
class CourseMaterialTutorService <<Java control>> {
  +ask(userId: UUID, documentId: UUID, pageNumber: Integer, question: String): AnswerResponse
}
class MaterialAccessPolicy <<Java policy>> {
  +authorize(userId: UUID, documentId: UUID, pageNumber: Integer): PageScope
}
class AiClient <<HTTP adapter>> {
  +askCourseMaterial(scope: PageScope, question: String): AnswerResponse
}
class CourseMaterialTutorPipeline <<Python control>> {
  +run(scope: PageScope, question: String): AnswerResponse
}
class PageScope <<DTO>> {
  +documentId: UUID
  +documentVersion: Integer
  +courseOfferingId: UUID
  +currentPage: Integer
  +allowedPageNumbers: Integer[]
}
class GroundingValidator <<Python service>> {
  +validate(answer: GeneratedAnswer, evidence: EvidenceSet): ValidationResult
}

CourseMaterialTutorController ..> PageQuestion
CourseMaterialTutorController --> CourseMaterialTutorService
CourseMaterialTutorService --> MaterialAccessPolicy
MaterialAccessPolicy ..> PageScope
CourseMaterialTutorService --> AiClient
AiClient ..> CourseMaterialTutorPipeline : internal HTTP
CourseMaterialTutorPipeline --> GroundingValidator

note bottom of MaterialAccessPolicy
Kiểm tra enrollment APPROVED, publication và READY
trước lời gọi AI và trước khi trả nội dung PDF.
Tutor này chỉ dành cho Student.
end note
@enduml
