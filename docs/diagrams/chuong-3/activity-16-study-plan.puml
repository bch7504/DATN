@startuml
' Palette: activity; based on the Visual Paradigm swimlane sample supplied by the project owner.
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #111111
skinparam ArrowColor #222222
skinparam ActivityBackgroundColor #7ACFF5
skinparam ActivityBorderColor #222222
skinparam ActivityDiamondBackgroundColor #7ACFF5
skinparam ActivityDiamondBorderColor #222222
skinparam ActivityStartColor #111111
skinparam ActivityEndColor #111111
skinparam PartitionBackgroundColor white
skinparam PartitionBorderColor #222222
skinparam NoteBackgroundColor #FFF9D9
skinparam NoteBorderColor #555555
skinparam roundcorner 16
|Student|
start
:Mở Kế hoạch & Lịch;
:Chọn tuần hoặc ô giờ;
:Nhập task ôn tập / lịch học;
note right
Student chủ động lập lịch.
AI không tự điều phối kế hoạch.
end note
|Java Backend|
:Kiểm owner, field và thời gian;
if (Hợp lệ?) then (Có)
  :Lưu Study Plan Item;
  |Frontend|
  :Hiển thị item trên lịch tuần;
  |Student|
  if (Hoàn tất task?) then (Có)
    |Java Backend|
    :Ghi STUDY_TASK_COMPLETED một lần;
    stop
  else (Chưa)
    stop
  endif
else (Không)
  |Student|
  :Nhận lỗi field/access;
  stop
endif
@enduml
