# StudyFlow local environment template.
# Copy this file to .env locally and replace every change_me/empty value.
# Never expose backend, AI, database or storage credentials with NEXT_PUBLIC_*.

# Next.js Web — public browser configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Fixture UI is available only when this is explicitly true.
NEXT_PUBLIC_DEMO_MODE=true

# Java Spring Boot — public API and system of record
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/studyflow?currentSchema=app
DATABASE_USERNAME=studyflow
DATABASE_PASSWORD=change_me
JWT_SECRET=change_me
AI_SERVICE_URL=http://localhost:8000/internal/v1
AI_SERVICE_TOKEN=change_me

# Python FastAPI/worker — internal AI service
ENVIRONMENT=local
# Must have the same value as AI_SERVICE_TOKEN above.
INTERNAL_SERVICE_TOKEN=change_me
AI_DATABASE_URL=postgresql+psycopg://studyflow_ai:change_me@localhost:5432/studyflow?options=-csearch_path%3Dai
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-5.6-luna
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DISTANCE=cosine
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_DISTANCE=0.45
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_RETRY_BASE_SECONDS=5
AI_WORKER_POLL_SECONDS=2

# S3-compatible Object Storage — used through server-side services only
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=documents
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me

# Vector search uses the pgvector extension in the PostgreSQL database above.
