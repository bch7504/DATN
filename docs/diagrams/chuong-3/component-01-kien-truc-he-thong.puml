@startuml
' Palette: architecture; layered platform form based on the supplied reference.
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #111111
skinparam ArrowColor #334155
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
skinparam roundcorner 12
skinparam PackageStyle rectangle
skinparam PackagePadding 34
skinparam RectangleBorderColor #64748B
skinparam RectangleBackgroundColor #F8FAFC
skinparam ComponentBorderColor #64748B
skinparam ComponentBackgroundColor #E8F4FB
skinparam DatabaseBorderColor #64748B
skinparam DatabaseBackgroundColor #EEF5DF
skinparam StorageBorderColor #64748B
skinparam StorageBackgroundColor #FFF3D6
skinparam CloudBorderColor #8064A2
skinparam CloudBackgroundColor #F2EAFB
skinparam ActorBackgroundColor #7ACFF5
skinparam ActorBorderColor #222222
left to right direction

actor "Student / Teacher / Admin" as user

rectangle "StudyFlow Platform" as platform {
  component "Next.js Web\nGiao diện và route guard" as web

  rectangle "Backend services" as backend {
    component "Java Spring Boot\nAuth · RBAC · nghiệp vụ\nQuiz lifecycle · progress" as java
    component "Python FastAPI\nParsing · RAG · citation\nSinh Quiz · evaluation" as ai
  }

  rectangle "Platform data & file storage" as data {
    database "PostgreSQL\nschema app\nJava sở hữu" as appdb
    database "PostgreSQL + pgvector\nschema ai\nPython sở hữu" as aidb
    storage "Object Storage\nTài liệu và slide artifacts" as storage
  }

  web --> java : REST /api/v1
  java --> ai : Internal API\nauthorized scope
  java --> appdb
  ai --> aidb
  java --> storage : quản lý metadata / cấp URL
  ai --> storage : đọc và render theo scope
}

cloud "Model Provider\nChat model · Embedding model" as model

user --> web
model -down-> ai : HTTPS
@enduml
