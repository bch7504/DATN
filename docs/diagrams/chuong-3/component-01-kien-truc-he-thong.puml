@startuml
' Palette: architecture; strict black-and-white layered style.
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #000000
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #000000
skinparam ComponentBorderColor #000000
skinparam ComponentBackgroundColor #FFFFFF
skinparam RectangleBorderColor #000000
skinparam RectangleBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam nodesep 36
skinparam ranksep 48
top to bottom direction

actor "Người dùng" as User
rectangle "StudyFlow Platform" as Platform {
  rectangle "FE" as FeLayer {
    component "Next.js\nTypeScript" as Web
  }
  rectangle "BE" as BeLayer {
    component "Spring Boot\nJava" as Backend
    rectangle "AI Service" as AiLayer {
      component "FastAPI\nPython" as AiApi
      component "Single Agent\nLangChain" as Agent
      component "RAG" as Rag
      component "Quiz AI" as QuizAi
    }
  }
  rectangle "Data & Storage" as DataLayer {
    database "PostgreSQL\napp" as AppDb
    database "PostgreSQL + pgvector\nai" as AiDb
    component "Object Storage" as Storage
  }
}
rectangle "External" as External {
  component "OpenRouter" as OpenRouter
}

User -down-> Web
Web -down-> Backend
Backend -right-> AiApi
AiApi -right-> Agent
Agent -down-> Rag
Agent -down-> QuizAi
Backend -down-> AppDb
Backend -down-> Storage
AiApi -down-> AiDb
AiApi -down-> Storage
Agent -down-> OpenRouter
@enduml
