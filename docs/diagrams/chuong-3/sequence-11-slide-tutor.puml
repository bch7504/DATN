@startuml
' Palette: sequence; monochrome Visual Paradigm-style interaction.
' Monochrome: true
' Interaction: Course Material AI Tutor
' InteractionFrame: none
' ActivationPolicy: full
' Split PNG height: 3932
skinparam defaultFontColor #000000
skinparam ArrowColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ControlBackgroundColor #FFFFFF
skinparam ControlBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam LifeLineBackgroundColor #FFFFFF
skinparam LifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceLifeLineBorderColor #000000
skinparam sequence {
  LifeLineBackgroundColor #FFFFFF
  LifeLineBorderColor #000000
}
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #000000
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 26
skinparam roundcorner 0
hide footbox
autonumber

actor Student
boundary "«view»\n:SlideViewerView" as Viewer
boundary "«view»\n:AiTutorView" as TutorPanel
control "CourseMaterialTutorDAO" as Controller
control "TutorConversationDAO" as Service
control "MaterialAccessDAO" as AccessPolicy
control "AiGatewayDAO" as AiClient
control "TutorPipelineDAO" as Pipeline
control "DocumentIndexDAO" as Retriever
control "GroundingValidationDAO" as Validator
entity ":CourseEnrollment" as Enrollment
entity ":DocumentPublication" as Publication
entity ":CourseMaterial" as Material
entity ":DocumentIndex" as Index
entity ":DocumentChunk" as Chunk
boundary "«external system»\nModel Provider" as Model

activate Student
activate Viewer
Student ->> Viewer : showPage(pageNumber)
Student ->> Viewer : toggleTutor()
Viewer -> TutorPanel ++ : open(documentId, pageNumber)
TutorPanel --> Viewer -- : void - đã mở Tutor
deactivate Viewer
Student ->> TutorPanel ++ : ask(question)
TutorPanel -> Controller ++ : ask(documentId, pageNumber, PageQuestion)
Controller -> Service ++ : ask(studentId, documentId, pageNumber, question)
Service -> AccessPolicy ++ : authorizeTutor(studentId, documentId, pageNumber)
AccessPolicy -> Enrollment ++ : đọc trạng thái APPROVED
Enrollment --> AccessPolicy -- : EnrollmentSnapshot
AccessPolicy -> Publication ++ : đọc trạng thái công bố
Publication --> AccessPolicy -- : PublicationSnapshot
AccessPolicy -> Material ++ : đọc SLIDE_PDF, READY và version
Material --> AccessPolicy -- : MaterialSnapshot
AccessPolicy --> Service -- : PageScope hoặc lỗi quyền/loại tài liệu
alt Không có quyền hoặc tài liệu không hỗ trợ Tutor
note right of Service
Đặt kết quả ACCESS_DENIED hoặc
MATERIAL_NOT_TUTORABLE; không gọi AI.
end note
else Phạm vi hợp lệ
Service -> AiClient ++ : askCourseMaterial(scope, question)
AiClient -> Pipeline ++ : run(scope, question)
Pipeline -> Retriever ++ : search(scope, question)
Retriever -> Index ++ : đọc chỉ mục theo document/version
Index --> Retriever -- : IndexSnapshot
Retriever -> Model ++ : embedding(question)
Model --> Retriever -- : QueryVector
Retriever -> Chunk ++ : tìm từ khóa + vector trong scope
Chunk --> Retriever -- : CandidateChunks
Retriever -> Model ++ : rerank(question, CandidateChunks)
Model --> Retriever -- : RankedEvidence
Retriever --> Pipeline -- : EvidenceSet theo trang
alt Không đủ bằng chứng
note right of Pipeline
Đặt kết quả NO_EVIDENCE; không sinh câu trả lời.
end note
else Có bằng chứng
Pipeline -> Model ++ : sinh answer từ evidence
Model --> Pipeline -- : GeneratedAnswer + citations
Pipeline -> Validator ++ : validate(answer, evidence)
Validator --> Pipeline -- : ValidationResult
note right of Pipeline
Hợp lệ: ANSWERED.
Không hợp lệ: NO_EVIDENCE.
end note
end
Pipeline --> AiClient -- : AnswerResponse
AiClient --> Service -- : AnswerResponse
Service -> AccessPolicy ++ : authorizeTutor(studentId, documentId, pageNumber)
AccessPolicy -> Enrollment ++ : kiểm tra enrollment hiện tại
Enrollment --> AccessPolicy -- : trạng thái enrollment
AccessPolicy -> Publication ++ : kiểm tra chưa bị thu hồi
Publication --> AccessPolicy -- : trạng thái publication
AccessPolicy -> Material ++ : kiểm tra phiên bản và trạng thái hiện tại
Material --> AccessPolicy -- : trạng thái tài liệu
AccessPolicy --> Service -- : PageScope hiện tại hoặc lỗi quyền
note right of Service
Chỉ trả nội dung khi quyền vẫn hợp lệ.
Quyền đã thu hồi: trả lỗi, không lộ câu trả lời.
end note
end
Service --> Controller -- : AnswerResponse hoặc lỗi theo contract
Controller --> TutorPanel -- : AnswerResponse hoặc lỗi theo contract
TutorPanel ->> Student : hiển thị kết quả
note right of Service
ASK_AI không cập nhật tiến độ hoặc Study Streak.
Teacher không có Course Material Tutor.
end note
deactivate TutorPanel
deactivate Student
@enduml
