@startuml
' Palette: sequence; based on the Visual Paradigm guide samples (see README).
' Monochrome: true
' Interaction: Course Material AI Tutor
skinparam defaultFontColor #000000
skinparam ArrowColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam LifeLineBackgroundColor #FFFFFF
skinparam LifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceLifeLineBorderColor #000000
skinparam sequence {
  LifeLineBackgroundColor #FFFFFF
  LifeLineBorderColor #000000
}
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #000000
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam roundcorner 10
hide footbox
autonumber
autoactivate on

actor Student
participant ":PDF Viewer" as Web
participant ":Java Backend" as Java
participant ":Python AI" as AI
participant ":pgvector (ai)" as DB
participant ":Model Provider" as LLM

Student -> Web : Hỏi về trang PDF đang xem
Web -> Java : POST /student/materials/{documentId}/pages/{pageNumber}/tutor
Java -> Java : Enrollment APPROVED, publication, READY, version
alt Không được phép hoặc đã revoke
  Java --> Web : Lỗi access; không gọi AI
else Hợp lệ
  Java -> AI : POST /internal/v1/course-materials/ask
  AI -> LLM : Embed query cùng index version
  LLM --> AI : Query vector
  AI -> DB : Retrieval đúng document/version/allowed pages
  DB --> AI : Evidence theo trang
  alt Không đủ căn cứ
    AI --> Java : NO_EVIDENCE
  else Đủ căn cứ
    AI -> LLM : Ngữ cảnh trang và câu hỏi
    LLM --> AI : Answer + citations
    AI -> AI : Validate; rewrite tối đa 1 lần
    AI --> Java : ANSWERED hoặc NO_EVIDENCE
  end
  Java -> Java : Revalidate access và citation
  Java --> Web : documentId + pageNumber + excerpt
  Web --> Student : Giải thích cạnh trang PDF
end
return Hoàn tất tương tác

note over AI,DB
ASK_AI không tăng page progress hoặc Study Streak.
Teacher không có Course Material Tutor.
end note
@enduml
