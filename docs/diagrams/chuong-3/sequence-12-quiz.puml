@startuml
' Palette: sequence; monochrome Visual Paradigm-style interaction.
' Monochrome: true
' Interaction: Sinh và duyệt Quiz AI
' InteractionFrame: none
skinparam defaultFontColor #000000
skinparam ArrowColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ControlBackgroundColor #FFFFFF
skinparam ControlBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam LifeLineBackgroundColor #FFFFFF
skinparam LifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceLifeLineBorderColor #000000
skinparam sequence {
  LifeLineBackgroundColor #FFFFFF
  LifeLineBorderColor #000000
}
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #000000
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam roundcorner 0
hide footbox
autonumber

actor "Student / Teacher" as User
boundary "«view»\n:QuizCreateView" as CreateForm
boundary "«view»\n:QuizStatusView" as StatusView
boundary "«view»\n:QuizReviewView" as ReviewView
control "QuizDAO" as Controller
control "QuizLifecycleDAO" as Service
control "QuizAccessDAO" as AccessPolicy
control "QuizGenerationJobDAO" as Job
control "AiGatewayDAO" as AiClient
control "QuizGeneratorDAO" as Generator
control "DocumentIndexDAO" as Retriever
control "QuizValidationDAO" as Validator
entity ":Document" as Document
entity ":Quiz" as Quiz
entity ":QuizSource" as Source
entity ":QuizQuestion" as Question
entity ":QuizQuestionSource" as QuestionSource
boundary "«external system»\nModel Provider" as Model

User -> CreateForm : selectDocuments(ids)
User -> CreateForm : setConstraints(count, difficulty, topic)
CreateForm -> Controller ++ : generate(QuizRequest)
Controller -> Service ++ : create(actorId, request)
Service -> AccessPolicy ++ : authorizeGeneration(actorId, request)
loop Mỗi tài liệu nguồn
  AccessPolicy -> Document : kiểm owner/publication, READY và version
end
alt Phạm vi hoặc cấu hình không hợp lệ
  AccessPolicy --> Service -- : validation/access error
  Service --> Controller -- : lỗi theo contract
  Controller --> CreateForm -- : hiển thị lỗi
else Hợp lệ
  AccessPolicy --> Service -- : AuthorizedScope
  Service -> Quiz : tạo GENERATING + runId
  Service -> Source : lưu snapshot document/version/page range
  Service -> Job ++ : execute(quizId, runId)
  Service --> Controller -- : AcceptedQuiz(202)
  Controller --> CreateForm -- : quizId + GENERATING

  Job -> AiClient ++ : generate(InternalQuizRequest)
  AiClient -> Generator ++ : generate(scope, constraints)
  Generator -> Retriever ++ : search(scope, constraints)
  Retriever -> Document : xác nhận source snapshot
  Retriever -> Model : embedding/rerank query
  Model --> Retriever : evidence ranking
  Retriever --> Generator -- : EvidenceSet theo trang
  alt Không đủ evidence
    Generator --> AiClient -- : NO_EVIDENCE
    AiClient --> Job -- : generation error
    Job -> Quiz : status = GENERATION_FAILED
  else Đủ evidence
    Generator -> Model : JSON Schema MCQ_SINGLE + evidence
    Model --> Generator : QuizDraft
    Generator -> Validator : validate(draft, evidence)
    alt Draft không đúng schema hoặc grounding
      Validator --> Generator : invalid
      Generator --> AiClient -- : validation error
      AiClient --> Job -- : generation error
      Job -> Quiz : status = GENERATION_FAILED
    else Draft hợp lệ
      Validator --> Generator : valid
      Generator --> AiClient -- : QuizDraft
      AiClient --> Job -- : QuizDraft
      loop Mỗi câu trong draft
        Job -> Question : tạo MCQ_SINGLE với đúng 4 options
        Job -> QuestionSource : lưu documentId/pageNumber/excerpt
      end
      Job -> Quiz : status = REVIEW_REQUIRED
    end
  end
  deactivate Job

  loop Cho đến khi status khác GENERATING hoặc hết số lần poll
    StatusView -> Controller ++ : getStatus(quizId)
    Controller -> Quiz : đọc status và questions
    Quiz --> Controller : QuizSummary
    Controller --> StatusView -- : QuizSummary
  end

  alt status = GENERATION_FAILED
    StatusView -> StatusView : showFailure(errorCode)
  else status = REVIEW_REQUIRED và Student tạo Quiz cá nhân
    StatusView -> ReviewView : showQuestions(quiz)
    alt Student chấp nhận
      User -> ReviewView : acceptStudent()
      ReviewView -> Controller ++ : accept(quizId, AcceptQuizRequest)
      Controller -> Service ++ : acceptStudent(studentId, quizId)
      Service -> Quiz : status = READY
      Service --> Controller -- : QuizSummary
      Controller --> ReviewView -- : QuizSummary
    else Student từ chối
      User -> ReviewView : reject()
      ReviewView -> Controller ++ : reject(quizId)
      Controller -> Service ++ : reject(studentId, quizId)
      Service -> Quiz : status = REJECTED
      Service --> Controller -- : QuizSummary
      Controller --> ReviewView -- : QuizSummary
    end
  else status = REVIEW_REQUIRED và Teacher tạo Quiz lớp
    StatusView -> ReviewView : showQuestions(quiz)
    alt Teacher công bố
      User -> ReviewView : publishTeacher()
      ReviewView -> Controller ++ : publish(quizId, PublishQuizRequest)
      Controller -> Service ++ : publishTeacher(teacherId, quizId)
      Service -> Quiz : status = PUBLISHED
      Service --> Controller -- : QuizSummary
      Controller --> ReviewView -- : QuizSummary
    else Teacher từ chối
      User -> ReviewView : reject()
      ReviewView -> Controller ++ : reject(quizId)
      Controller -> Service ++ : reject(teacherId, quizId)
      Service -> Quiz : status = REJECTED
      Service --> Controller -- : QuizSummary
      Controller --> ReviewView -- : QuizSummary
    end
  else Vẫn GENERATING sau giới hạn poll
    StatusView -> StatusView : showFailure("POLL_TIMEOUT")
  end
end

note over Job,Question
Python chỉ tạo QuizDraft. Java kiểm tra lần cuối và lưu entity.
Mỗi câu có đúng bốn lựa chọn, một đáp án và citation theo trang.
end note
@enduml
