@startuml
' Palette: sequence; monochrome Visual Paradigm-style interaction.
' Monochrome: true
' Interaction: Sinh và duyệt Quiz AI
' InteractionFrame: none
' ActivationPolicy: full
' Split PNG height: 7622
skinparam defaultFontColor #000000
skinparam ArrowColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ControlBackgroundColor #FFFFFF
skinparam ControlBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam LifeLineBackgroundColor #FFFFFF
skinparam LifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceLifeLineBorderColor #000000
skinparam sequence {
  LifeLineBackgroundColor #FFFFFF
  LifeLineBorderColor #000000
}
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #000000
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 26
skinparam roundcorner 0
hide footbox
autonumber

actor "Student / Teacher" as User
boundary "«view»\n:QuizCreateView" as CreateForm
boundary "«view»\n:QuizStatusView" as StatusView
boundary "«view»\n:QuizReviewView" as ReviewView
control "QuizDAO" as Controller
control "QuizLifecycleDAO" as Service
control "QuizAccessDAO" as AccessPolicy
control "QuizGenerationJobDAO" as Job
control "AiGatewayDAO" as AiClient
control "QuizGeneratorDAO" as Generator
control "DocumentIndexDAO" as Retriever
control "QuizValidationDAO" as Validator
entity ":Document" as Document
entity ":Quiz" as Quiz
entity ":QuizSource" as Source
entity ":QuizQuestion" as Question
entity ":QuizQuestionSource" as QuestionSource
boundary "«external system»\nModel Provider" as Model

activate User
activate CreateForm
User ->> CreateForm : selectDocuments(ids)
User ->> CreateForm : setConstraints(count, difficulty, topic)
CreateForm -> Controller ++ : generate(QuizRequest)
Controller -> Service ++ : create(actorId, request)
Service -> AccessPolicy ++ : authorizeGeneration(actorId, request)
loop Mỗi tài liệu nguồn
AccessPolicy -> Document ++ : đọc owner, publication, READY và version
Document --> AccessPolicy -- : DocumentSnapshot
end
AccessPolicy --> Service -- : AuthorizedScope hoặc lỗi validation/access
alt Phạm vi hoặc cấu hình không hợp lệ
note right of Service
Đặt kết quả lỗi; không tạo công việc AI.
end note
else Hợp lệ
Service -> Quiz ++ : tạo GENERATING + runId
Quiz --> Service -- : quizId + GENERATING
Service -> Source ++ : lưu snapshot tài liệu/phiên bản/phạm vi trang
Source --> Service -- : đã lưu QuizSource
Service ->> Job ++ : execute(quizId, runId)
deactivate Job
end
Service --> Controller -- : AcceptedQuiz(202) hoặc lỗi theo contract
Controller --> CreateForm -- : quizId + GENERATING hoặc lỗi
CreateForm ->> User : hiển thị tiếp nhận hoặc lỗi
opt Yêu cầu được tiếp nhận (202)
CreateForm ->> StatusView ++ : mở theo dõi quizId
opt Có công việc sinh Quiz được tiếp nhận
note right of Job
Worker chạy độc lập với HTTP ban đầu.
Polling có thể diễn ra trong lúc worker xử lý.
end note
activate Job
Job -> AiClient ++ : generate(InternalQuizRequest)
AiClient -> Generator ++ : generate(scope, constraints)
Generator -> Retriever ++ : search(scope, constraints)
Retriever -> Model ++ : embedding(query)
Model --> Retriever -- : QueryVector
note right of Retriever
Tìm trên chỉ mục AI, đúng document/version/scope.
Kết hợp từ khóa và vector; không đọc bảng Java.
end note
Retriever -> Model ++ : rerank(query, CandidateChunks)
Model --> Retriever -- : RankedEvidence
Retriever --> Generator -- : EvidenceSet theo trang
alt Không đủ bằng chứng
note right of Generator
Đặt kết quả NO_EVIDENCE; không sinh câu hỏi.
end note
else Có bằng chứng
Generator -> Model ++ : sinh MCQ_SINGLE theo JSON Schema + evidence
Model --> Generator -- : QuizDraft
Generator -> Validator ++ : validate(draft, evidence)
Validator --> Generator -- : ValidationResult
note right of Generator
Bản nháp đạt: QuizDraft.
Không đạt: lỗi validation.
end note
end
Generator --> AiClient -- : QuizDraft hoặc lỗi sinh nội dung
AiClient --> Job -- : QuizDraft hoặc lỗi sinh nội dung
note right of Job
Java kiểm tra lại quyền, cấu trúc và nguồn trước khi lưu.
end note
alt Lỗi sinh nội dung hoặc Java không chấp nhận
Job -> Quiz ++ : cập nhật GENERATION_FAILED
Quiz --> Job -- : đã lưu trạng thái thất bại
else Bản nháp hợp lệ và quyền còn hiệu lực
loop Mỗi câu trong draft
Job -> Question ++ : lưu MCQ_SINGLE: 4 options, 1 đáp án
Question --> Job -- : questionId
Job -> QuestionSource ++ : lưu documentId/pageNumber/excerpt
QuestionSource --> Job -- : đã lưu nguồn câu hỏi
end
Job -> Quiz ++ : cập nhật REVIEW_REQUIRED
Quiz --> Job -- : đã lưu trạng thái chờ duyệt
end
note right of Job
Kết thúc công việc nền, lưu JobResult.
Không trả kết quả vào HTTP 202 đã đóng.
end note
deactivate Job
end
opt Có quizId hợp lệ
loop Định kỳ đến khi không còn GENERATING hoặc hết lượt chờ
StatusView ->> StatusView : poll(quizId)
StatusView -> Controller ++ : getStatus(quizId)
Controller -> Quiz ++ : đọc trạng thái và câu hỏi được phép
Quiz --> Controller -- : QuizSummary
Controller --> StatusView -- : QuizSummary
end
alt GENERATION_FAILED hoặc hết lượt chờ
StatusView -> StatusView ++ : showFailure(errorCode)
StatusView --> StatusView -- : void - đã hiển thị thông báo
else REVIEW_REQUIRED
StatusView -> ReviewView ++ : showQuestions(quiz)
ReviewView --> StatusView -- : void - đã hiển thị bản nháp
alt Student chấp nhận Quiz cá nhân
User ->> ReviewView ++ : acceptStudent()
ReviewView -> Controller ++ : accept(quizId, AcceptQuizRequest)
Controller -> Service ++ : acceptStudent(studentId, quizId)
alt Được phép và Quiz còn chờ duyệt
Service -> Quiz ++ : cập nhật READY
Quiz --> Service -- : QuizSummary
else Không còn quyền hoặc trạng thái đã thay đổi
note right of Service
Trả lỗi; giữ nguyên Quiz.
end note
end
Service --> Controller -- : QuizSummary hoặc lỗi quyền/trạng thái
Controller --> ReviewView -- : QuizSummary hoặc lỗi quyền/trạng thái
ReviewView ->> User : hiển thị kết quả quyết định
deactivate ReviewView
else Teacher công bố Quiz lớp
User ->> ReviewView ++ : publishTeacher()
ReviewView -> Controller ++ : publish(quizId, PublishQuizRequest)
Controller -> Service ++ : publishTeacher(teacherId, quizId)
alt Được phép và Quiz còn chờ duyệt
Service -> Quiz ++ : cập nhật PUBLISHED
Quiz --> Service -- : QuizSummary
else Không còn quyền hoặc trạng thái đã thay đổi
note right of Service
Trả lỗi; giữ nguyên Quiz.
end note
end
Service --> Controller -- : QuizSummary hoặc lỗi quyền/trạng thái
Controller --> ReviewView -- : QuizSummary hoặc lỗi quyền/trạng thái
ReviewView ->> User : hiển thị kết quả quyết định
deactivate ReviewView
else Người tạo từ chối bản nháp
User ->> ReviewView ++ : reject()
ReviewView -> Controller ++ : reject(quizId)
Controller -> Service ++ : reject(actorId, quizId)
alt Được phép và Quiz còn chờ duyệt
Service -> Quiz ++ : cập nhật REJECTED
Quiz --> Service -- : QuizSummary
else Không còn quyền hoặc trạng thái đã thay đổi
note right of Service
Trả lỗi; giữ nguyên Quiz.
end note
end
Service --> Controller -- : QuizSummary hoặc lỗi quyền/trạng thái
Controller --> ReviewView -- : QuizSummary hoặc lỗi quyền/trạng thái
ReviewView ->> User : hiển thị kết quả quyết định
deactivate ReviewView
end
end
end
deactivate StatusView
end
note right of Job
Python chỉ trả bản nháp; Java sở hữu vòng đời Quiz.
Student không sinh Quiz trực tiếp từ học liệu lớp.
Teacher công bố Quiz trước khi giao thành bài tập.
end note
deactivate CreateForm
deactivate User
@enduml
