@startuml
' Palette: class; black-and-white View-DAO-Entity report style.
' Hình 3.6 - Thiết kế lớp sinh, duyệt và làm Quiz.
' Bố cục một mặt phẳng: View ở trên, DAO ở giữa, Entity ở dưới.
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #111111
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #000000
skinparam ClassBorderColor #000000
skinparam ClassFontColor #111111
skinparam ClassAttributeFontColor #111111
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #FFFFFF
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam classAttributeIconSize 0
skinparam nodesep 28
skinparam ranksep 52
hide circle
top to bottom direction

class QuizCreateView <<view>> {
  +selectDocuments(ids: UUID[]): void
  +setConstraints(count: Integer, difficulty: Difficulty, topic: String?): void
  +submit(): void
}
class QuizStatusView <<view>> {
  +poll(quizId: UUID): QuizSummary
  +showFailure(errorCode: String): void
}
class QuizReviewView <<view>> {
  +showQuestions(quiz: QuizSummary): void
  +acceptStudent(): void
  +publishTeacher(): void
  +reject(): void
}
class QuizAttemptView <<view>> {
  +start(quizId: UUID): QuizAttempt
  +selectAnswer(questionId: UUID, optionIndex: Integer): void
  +submit(): QuizResult
}
class QuizResultView <<view>> {
  +showScore(result: QuizResult): void
  +showReviewSources(): void
}

class QuizDAO <<DAO>> {
  +generate(body: QuizRequest): AcceptedQuiz
  +getStatus(id: UUID): QuizSummary
  +accept(id: UUID, body: AcceptQuizRequest): QuizSummary
  +publish(id: UUID, body: PublishQuizRequest): QuizSummary
  +reject(id: UUID): QuizSummary
}
class QuizLifecycleDAO <<DAO>> {
  +create(actorId: UUID, request: QuizRequest): AcceptedQuiz
  +acceptStudent(studentId: UUID, id: UUID): QuizSummary
  +publishTeacher(teacherId: UUID, id: UUID): QuizSummary
  +reject(actorId: UUID, id: UUID): QuizSummary
}
class QuizGenerationJobDAO <<DAO>> {
  +execute(quizId: UUID, runId: UUID): JobResult
}
class QuizAttemptDAO <<DAO>> {
  +start(quizId: UUID): QuizAttempt
  +submit(attemptId: UUID, body: SubmitAttemptRequest): QuizResult
}
class QuizScoringDAO <<DAO>> {
  +score(studentId: UUID, attemptId: UUID, answers: SubmittedAnswer[]): QuizResult
}
class QuizAccessDAO <<DAO>> {
  +authorizeGeneration(actorId: UUID, request: QuizRequest): AuthorizedScope
  +authorizeAttempt(studentId: UUID, quizId: UUID): void
}
class AiGatewayDAO <<DAO>> {
  +generate(request: InternalQuizRequest): QuizDraft
}
class QuizGeneratorDAO <<DAO>> {
  +generate(scope: AuthorizedScope, constraints: QuizConstraints): QuizDraft
}
class DocumentIndexDAO <<DAO>> {
  +search(scope: AuthorizedScope, constraints: QuizConstraints): EvidenceSet
}
class QuizValidationDAO <<DAO>> {
  +validate(draft: QuizDraft, evidence: EvidenceSet): ValidationResult
}

class Student <<entity>> {
  -id: UUID
  -status: UserStatus
}
class Teacher <<entity>> {
  -id: UUID
  -status: UserStatus
}
class CourseOffering <<entity>> {
  -id: UUID
  -teacherId: UUID
  -status: OfferingStatus
}
class Document <<entity>> {
  -id: UUID
  -ownerId: UUID
  -version: Integer
  -scope: DocumentScope
}
class Quiz <<entity>> {
  -id: UUID
  -createdBy: UUID
  -generationType: GenerationType
  -status: QuizStatus
  -questionCount: Integer
}
class QuizSource <<entity>> {
  -quizId: UUID
  -documentId: UUID
  -documentVersion: Integer
  -pageRange: PageRange?
}
class QuizQuestion <<entity>> {
  -id: UUID
  -content: Text
  -options: String[4]
  -correctOptionIndex: Integer
  -explanation: Text
}
class QuizQuestionSource <<entity>> {
  -questionId: UUID
  -documentId: UUID
  -pageNumber: Integer
  -excerpt: Text
}
class QuizAttempt <<entity>> {
  -id: UUID
  -studentId: UUID
  -startedAt: DateTime
  -submittedAt: DateTime?
  -score: Decimal?
}
class QuizAnswer <<entity>> {
  -attemptId: UUID
  -questionId: UUID
  -selectedOptionIndex: Integer
  -isCorrect: Boolean
}
class QuizRequest <<entity>> {
  +mode: GenerationMode
  +selectedDocumentIds: UUID[1..10]
  +questionCount: Integer
  +difficulty: Difficulty
  +topic: String?
  +pageRange: PageRange?
  +instructions: String?
}
class QuizDraft <<entity>> {
  +questions: McqSingleQuestion[]
}
class McqSingleQuestion <<entity>> {
  +content: String
  +options: String[4]
  +correctOptionIndex: Integer
  +explanation: String
  +sources: PageCitation[]
}

' Giữ ba vùng thị giác như mẫu: View trên, DAO giữa, Entity dưới.
QuizCreateView -[hidden]right- QuizStatusView
QuizStatusView -[hidden]right- QuizReviewView
QuizReviewView -[hidden]right- QuizAttemptView
QuizAttemptView -[hidden]right- QuizResultView
QuizDAO -[hidden]right- QuizLifecycleDAO
QuizLifecycleDAO -[hidden]right- QuizGenerationJobDAO
QuizGenerationJobDAO -[hidden]right- QuizAttemptDAO
QuizAttemptDAO -[hidden]right- QuizScoringDAO
QuizAccessDAO -[hidden]right- AiGatewayDAO
AiGatewayDAO -[hidden]right- QuizGeneratorDAO
QuizGeneratorDAO -[hidden]right- DocumentIndexDAO
DocumentIndexDAO -[hidden]right- QuizValidationDAO
QuizCreateView -[hidden]down- QuizDAO
QuizDAO -[hidden]down- QuizAccessDAO
QuizAccessDAO -[hidden]down- Student

' View navigation and View-to-DAO dependencies.
QuizCreateView --> QuizStatusView
QuizStatusView --> QuizReviewView
QuizReviewView --> QuizAttemptView
QuizAttemptView --> QuizResultView
QuizCreateView ..> QuizRequest
QuizCreateView ..> QuizDAO
QuizStatusView ..> QuizDAO
QuizReviewView ..> QuizDAO
QuizAttemptView ..> QuizAttemptDAO
QuizResultView ..> QuizAttemptDAO

' DAO flow.
QuizDAO ..> QuizLifecycleDAO
QuizLifecycleDAO ..> QuizAccessDAO
QuizLifecycleDAO ..> QuizGenerationJobDAO
QuizGenerationJobDAO ..> AiGatewayDAO
AiGatewayDAO ..> QuizGeneratorDAO : internal HTTP
QuizGeneratorDAO ..> DocumentIndexDAO
QuizGeneratorDAO ..> QuizValidationDAO
QuizAttemptDAO ..> QuizScoringDAO
QuizScoringDAO ..> QuizAccessDAO

' Entity associations, aggregation and composition.
Student "1" -- "0..*" Quiz : creates personal
Teacher "1" -- "0..*" Quiz : creates course
CourseOffering "0..1" -- "0..*" Quiz : review destination
Quiz "1" *-- "1..*" QuizSource
Document "1" -- "0..*" QuizSource
Quiz "1" *-- "1..*" QuizQuestion
QuizQuestion "1" *-- "1..*" QuizQuestionSource
Document "1" -- "0..*" QuizQuestionSource
Quiz "1" *-- "0..*" QuizAttempt
Student "1" -- "0..*" QuizAttempt
QuizAttempt "1" *-- "1..*" QuizAnswer
QuizQuestion "1" -- "0..*" QuizAnswer
QuizDraft "1" *-- "1..*" McqSingleQuestion

' DAO-to-Entity dependencies.
QuizAccessDAO ..> Student
QuizAccessDAO ..> Teacher
QuizAccessDAO ..> CourseOffering
QuizAccessDAO ..> Document
QuizLifecycleDAO ..> Quiz
QuizGenerationJobDAO ..> QuizSource
QuizGeneratorDAO ..> QuizDraft
QuizScoringDAO ..> QuizQuestion
QuizScoringDAO ..> QuizAnswer

note right of QuizValidationDAO
  Mỗi câu MCQ_SINGLE có đúng bốn lựa chọn,
  một đáp án đúng và nguồn nằm trong phạm vi được cấp quyền.
end note

note right of QuizScoringDAO
  Java chấm điểm và lưu từng attempt riêng.
  Python/LLM chỉ tạo bản nháp Quiz.
end note
@enduml
