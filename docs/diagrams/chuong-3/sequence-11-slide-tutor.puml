@startuml
' Palette: sequence; monochrome Visual Paradigm-style interaction.
' Monochrome: true
' Interaction: Course Material AI Tutor
' InteractionFrame: none
skinparam defaultFontColor #000000
skinparam ArrowColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ControlBackgroundColor #FFFFFF
skinparam ControlBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam LifeLineBackgroundColor #FFFFFF
skinparam LifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceLifeLineBorderColor #000000
skinparam sequence {
  LifeLineBackgroundColor #FFFFFF
  LifeLineBorderColor #000000
}
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #000000
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam roundcorner 0
hide footbox
autonumber

actor Student
boundary "«view»\n:SlideViewerView" as Viewer
boundary "«view»\n:AiTutorView" as TutorPanel
control "CourseMaterialTutorDAO" as Controller
control "TutorConversationDAO" as Service
control "MaterialAccessDAO" as AccessPolicy
control "AiGatewayDAO" as AiClient
control "TutorPipelineDAO" as Pipeline
control "DocumentIndexDAO" as Retriever
control "GroundingValidationDAO" as Validator
entity ":CourseEnrollment" as Enrollment
entity ":DocumentPublication" as Publication
entity ":CourseMaterial" as Material
entity ":DocumentIndex" as Index
entity ":DocumentChunk" as Chunk
boundary "«external system»\nModel Provider" as Model

Student -> Viewer : showPage(pageNumber)
Student -> Viewer : toggleTutor()
Viewer -> TutorPanel : open(documentId, pageNumber)
Student -> TutorPanel : ask(question)
TutorPanel -> Controller ++ : ask(documentId, pageNumber, PageQuestion)
Controller -> Service ++ : ask(studentId, documentId, pageNumber, question)
Service -> AccessPolicy ++ : authorizeTutor(studentId, documentId, pageNumber)
AccessPolicy -> Enrollment : kiểm status = APPROVED
AccessPolicy -> Publication : kiểm status = PUBLISHED
AccessPolicy -> Material : kiểm SLIDE_PDF, READY và version
alt Không còn quyền hoặc tài liệu không hỗ trợ Tutor
  AccessPolicy --> Service -- : ACCESS_DENIED / MATERIAL_NOT_TUTORABLE
  Service --> Controller -- : lỗi theo contract
  Controller --> TutorPanel -- : hiển thị lỗi; không gọi AI
else Phạm vi hợp lệ
  AccessPolicy --> Service -- : PageScope
  Service -> AiClient ++ : askCourseMaterial(scope, question)
  AiClient -> Pipeline ++ : run(scope, question)
  Pipeline -> Retriever ++ : search(scope, question)
  Retriever -> Index : kiểm document/version/index status
  Retriever -> Chunk : hybrid retrieval trong allowedPageNumbers
  Retriever -> Model : embedding/rerank query
  Model --> Retriever : vector/rerank scores
  Retriever --> Pipeline -- : EvidenceSet theo trang
  alt Không đủ bằng chứng
    Pipeline --> AiClient -- : NO_EVIDENCE
  else Có bằng chứng
    Pipeline -> Model : sinh answer từ evidence
    Model --> Pipeline : GeneratedAnswer + citations
    Pipeline -> Validator : validate(answer, evidence)
    alt Citation hoặc grounding không hợp lệ
      Validator --> Pipeline : invalid
      Pipeline --> AiClient -- : NO_EVIDENCE
    else Hợp lệ
      Validator --> Pipeline : valid
      Pipeline --> AiClient -- : AnswerResponse(ANSWERED)
    end
  end
  AiClient --> Service -- : AnswerResponse
  Service -> AccessPolicy ++ : authorizeTutor(...) lần cuối
  AccessPolicy -> Publication : kiểm chưa bị revoke
  AccessPolicy --> Service -- : quyền hiện tại hợp lệ
  Service --> Controller -- : AnswerResponse
  Controller --> TutorPanel -- : showAnswer(response)
  TutorPanel --> Student : hiển thị answer + page citations
  opt Student mở citation
    Student -> TutorPanel : openCitation(citation)
    TutorPanel --> Student : hiển thị nguồn theo pageNumber
  end
end

note over Service,Material
ASK_AI không cập nhật LearningProgress hoặc Study Streak.
Teacher không có Course Material Tutor.
end note
@enduml
