@startuml
' Palette: physical/logical entity diagram based on the Visual Paradigm ERD sample.
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #111111
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 34
skinparam ranksep 44
skinparam ArrowColor #222222
skinparam EntityBackgroundColor #F2BB7B
skinparam EntityBorderColor #222222
skinparam EntityFontColor #111111
skinparam EntityAttributeFontColor #111111
hide circle
left to right direction

entity "users" as users #F2BB7B {
  * id : uuid <<PK>>
  --
  email : varchar(255) <<UQ>>
  role : varchar(20)
  time_zone : varchar(64)
}
entity "subjects" as subjects #F2BB7B {
  * id : uuid <<PK>>
  --
  code : varchar(30) <<UQ>>
  name : varchar(255)
}
entity "semesters" as semesters #F2BB7B {
  * id : uuid <<PK>>
  --
  code : varchar(30) <<UQ>>
  status : varchar(20)
}
entity "course_offerings" as offerings #F2BB7B {
  * id : uuid <<PK>>
  --
  subject_id : uuid <<FK>>
  semester_id : uuid <<FK>>
  teacher_id : uuid <<FK>>
  status : varchar(20)
}
entity "course_enrollments" as enrollments #F2BB7B {
  * id : uuid <<PK>>
  --
  course_offering_id : uuid <<FK>>
  student_id : uuid <<FK>>
  status : varchar(20)
}
entity "documents" as documents #F2BB7B {
  * id : uuid <<PK>>
  --
  owner_id : uuid <<FK>>
  document_version : integer
  scope : varchar(30)
  file_type : varchar(10) = PDF
  page_count : integer
  processing_status : varchar(20)
}
entity "document_publications" as publications #F2BB7B {
  * id : uuid <<PK>>
  --
  document_id : uuid <<FK>>
  course_offering_id : uuid <<FK>>
  status : varchar(20)
}
entity "document_pages" as pages #F2BB7B {
  * id : uuid <<PK>>
  --
  document_id : uuid <<FK>>
  page_number : integer
  text_checksum : varchar(64)
}
entity "page_notes" as notes #F2BB7B {
  * id : uuid <<PK>>
  --
  student_id : uuid <<FK>>
  document_id : uuid <<FK>>
  page_number : integer
  content : text
}
entity "chat_conversations" as conversations #F2BB7B {
  * id : uuid <<PK>>
  --
  student_id : uuid <<FK>>
  type : varchar(30)
}
entity "quizzes" as quizzes #F2BB7B {
  * id : uuid <<PK>>
  --
  created_by : uuid <<FK>>
  creator_role : varchar(20)
  generation_mode : varchar(30)
  course_offering_id : uuid <<FK, nullable>>
  status : varchar(30)
}
entity "quiz_questions" as questions #F2BB7B {
  * id : uuid <<PK>>
  --
  quiz_id : uuid <<FK>>
  options : jsonb
  correct_option_index : smallint
  source_page_number : integer
}
entity "quiz_attempts" as attempts #F2BB7B {
  * id : uuid <<PK>>
  --
  quiz_id : uuid <<FK>>
  student_id : uuid <<FK>>
  score : numeric(5,2)
}
entity "learning_events" as events #F2BB7B {
  * id : uuid <<PK>>
  --
  student_id : uuid <<FK>>
  event_type : varchar(30)
  activity_date : date
}
entity "learning_progress" as progress #F2BB7B {
  * id : uuid <<PK>>
  --
  student_id : uuid <<FK>>
  document_id : uuid <<FK>>
  progress_percent : numeric(5,2)
}
entity "daily_goals" as goals #F2BB7B {
  * student_id : uuid <<PK, FK>>
  --
  page_target : integer
  quiz_question_target : integer
  task_target : integer
}
entity "study_plans" as plans #F2BB7B {
  * id : uuid <<PK>>
  --
  student_id : uuid <<FK>>
  title : varchar(255)
}
entity "study_plan_items" as plan_items #F2BB7B {
  * id : uuid <<PK>>
  --
  study_plan_id : uuid <<FK>>
  course_offering_id : uuid <<FK, nullable>>
  scheduled_at : timestamptz
  status : varchar(20)
}

users ||--o{ offerings
subjects ||--o{ offerings
semesters ||--o{ offerings
offerings ||--o{ enrollments
users ||--o{ enrollments
users ||--o{ documents
documents ||--o{ publications
offerings ||--o{ publications
documents ||--o{ pages
users ||--o{ notes
documents ||--o{ notes
users ||--o{ conversations
users ||--o{ quizzes
offerings |o--o{ quizzes
quizzes ||--o{ questions
quizzes ||--o{ attempts
users ||--o{ attempts
users ||--o{ events
users ||--o{ progress
documents ||--o{ progress
users ||--o| goals
users ||--o{ plans
plans ||--o{ plan_items
offerings |o--o{ plan_items
@enduml
