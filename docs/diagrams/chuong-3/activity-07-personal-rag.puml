@startuml
' Palette: activity; based on the Visual Paradigm swimlane sample supplied by the project owner.
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #111111
skinparam ArrowColor #222222
skinparam ActivityBackgroundColor #7ACFF5
skinparam ActivityBorderColor #222222
skinparam ActivityDiamondBackgroundColor #7ACFF5
skinparam ActivityDiamondBorderColor #222222
skinparam ActivityStartColor #111111
skinparam ActivityEndColor #111111
skinparam PartitionBackgroundColor white
skinparam PartitionBorderColor #222222
skinparam NoteBackgroundColor #FFF9D9
skinparam NoteBorderColor #555555
skinparam roundcorner 16

|Student|
start
:Chọn Personal PDF và gửi yêu cầu;
note right
Agent chỉ được chọn tool trong allowlist;
không đổi source scope hoặc luật MCQ_SINGLE.
end note
|Java Backend|
:Kiểm owner, READY và snapshot phiên bản;
if (Được phép?) then (Có)
  :Dựng authorized scope bất biến;
  |Python AI|
  :Single Agent nhận diện ý định;
  if (Đủ tham số cho tool?) then (Có)
    if (Loại yêu cầu?) then (Hỏi đáp)
      :Ask Document Tool;
    elseif (Tóm tắt)
      :Summarize Document Tool;
    else (Tạo Quiz)
      :Generate Quiz Tool;
    endif
    :Retrieval và evidence gate đúng scope;
    if (Đủ bằng chứng?) then (Có)
      :Sinh structured result và citation theo trang;
      :Kiểm schema và grounding;
      |Java Backend|
      :Revalidate quyền và response;
      :Lưu message hoặc Quiz REVIEW_REQUIRED;
      |Student|
      :Nhận ANSWERED, SUMMARY hoặc QUIZ_DRAFT;
      stop
    else (Không)
      |Student|
      :Nhận NO_EVIDENCE;
      stop
    endif
  else (Không)
    |Student|
    :Nhận NEEDS_CLARIFICATION;
    stop
  endif
else (Không)
  |Student|
  :Nhận lỗi truy cập an toàn;
  stop
endif
@enduml
