@startuml
' Palette: activity; based on the Visual Paradigm swimlane sample supplied by the project owner.
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #111111
skinparam ArrowColor #222222
skinparam ActivityBackgroundColor #7ACFF5
skinparam ActivityBorderColor #222222
skinparam ActivityDiamondBackgroundColor #7ACFF5
skinparam ActivityDiamondBorderColor #222222
skinparam ActivityStartColor #111111
skinparam ActivityEndColor #111111
skinparam PartitionBackgroundColor white
skinparam PartitionBorderColor #222222
skinparam NoteBackgroundColor #FFF9D9
skinparam NoteBorderColor #555555
skinparam roundcorner 16

|Student / Teacher|
start
:Chọn PDF, số câu, độ khó và yêu cầu;
note right
Student tạo Quiz từ Personal PDF trong Assistant.
Teacher tạo Quiz từ Course Material PDF, không có chatbot.
end note
|Java Backend|
:Xác định STUDENT_PERSONAL hoặc TEACHER_COURSE;
:Kiểm owner, READY, version và Course Offering;
if (Nguồn hợp lệ?) then (Có)
  :Tạo Quiz GENERATING;
  :Trả 202 + quizId;
  |Python AI|
  :Retrieval có scope và evidence gate;
  if (Đủ bằng chứng?) then (Có)
    :Sinh JSON MCQ_SINGLE;
    :Kiểm đúng 4 lựa chọn, 1 đáp án và citation;
    if (Hợp lệ sau tối đa 1 repair?) then (Có)
      |Java Backend|
      :Validate toàn bộ batch;
      :Lưu REVIEW_REQUIRED;
      |Student / Teacher|
      :Review bản nháp;
      if (Vai trò?) then (Student)
        :Accept hoặc Reject;
        |Java Backend|
        :Chuyển READY hoặc REJECTED;
        stop
      else (Teacher)
        :Sửa nội dung và Publish hoặc Reject;
        |Java Backend|
        :Chuyển PUBLISHED hoặc REJECTED;
        stop
      endif
    else (Không)
      |Java Backend|
      :Chuyển GENERATION_FAILED;
      stop
    endif
  else (Không)
    |Java Backend|
    :Chuyển GENERATION_FAILED;
    stop
  endif
else (Không)
  :Không tạo Quiz;
  stop
endif
@enduml
