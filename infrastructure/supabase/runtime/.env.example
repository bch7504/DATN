# Public template for a teammate running local services against shared Supabase data.
# Copy to <repository>/.env.supabase.runtime (ignored); obtain runtime values privately.
# No migration/admin database password is needed here. Never fill this tracked template.
DATABASE_URL=jdbc:postgresql://aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require&currentSchema=app
DATABASE_USERNAME=studyflow_app.bcrqhbrdkzwdasczewxp
DATABASE_PASSWORD=
# URL uses studyflow_ai.<project-ref> and the URL-encoded AI role password.
AI_DATABASE_URL=
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
# Must equal INTERNAL_SERVICE_TOKEN.
AI_SERVICE_TOKEN=
STORAGE_ENDPOINT=https://bcrqhbrdkzwdasczewxp.storage.supabase.co/storage/v1/s3
STORAGE_REGION=ap-southeast-2
STORAGE_BUCKET=studyflow-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Next.js continues calling the Java process on this teammate's own machine.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8088/api/v1
# AI provider key/settings remain in the AI application's normal private configuration.
