@startuml
' Palette: sequence; based on the Visual Paradigm guide samples (see README).
' Monochrome: true
' Interaction: Sinh và duyệt Quiz AI
skinparam defaultFontColor #000000
skinparam ArrowColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam LifeLineBackgroundColor #FFFFFF
skinparam LifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceLifeLineBorderColor #000000
skinparam sequence {
  LifeLineBackgroundColor #FFFFFF
  LifeLineBorderColor #000000
}
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #000000
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam roundcorner 10
hide footbox
autonumber
autoactivate on

actor "Student / Teacher" as User
participant ":Web" as Web
participant ":Java API / worker" as Java
participant ":Python AI" as AI
participant ":Model Provider" as LLM
participant ":app" as DB

User -> Web : Chọn PDF, số câu, độ khó và yêu cầu
Web -> Java : Tạo Quiz {mode, source, constraints}
Java -> Java : Kiểm owner / READY / Course Offering; snapshot nguồn
Java -> DB : Tạo Quiz GENERATING và run identity
Java --> Web : 202 {quizId, status}
Java -> AI : POST /internal/v1/quizzes/generate
AI -> AI : Retrieval có scope, evidence gate
alt Thiếu evidence
  AI --> Java : NO_EVIDENCE
else Đủ evidence
  AI -> LLM : JSON Schema MCQ_SINGLE
  LLM --> AI : Structured draft
  AI -> AI : Đúng 4 options, 1 đáp án, grounding; repair tối đa 1 lần
  AI --> Java : QuizDraft hoặc lỗi
end
alt Draft hợp lệ và nguồn còn được phép
  Java -> DB : Lưu batch; REVIEW_REQUIRED
else Lỗi hoặc không hợp lệ
  Java -> DB : GENERATION_FAILED; không lưu câu hỏi lỗi
end
loop Poll có backoff giới hạn
  Web -> Java : GET trạng thái Quiz
  Java --> Web : Trạng thái / bản nháp
end
alt Student tạo từ Personal Assistant
  User -> Web : Accept hoặc Reject
  Web -> Java : Chuyển trạng thái Quiz cá nhân
  Java -> DB : READY hoặc REJECTED
else Teacher tạo từ Course Material PDF
  User -> Web : Sửa rồi Publish hoặc Reject
  Web -> Java : Publish Quiz cho Course Offering
  Java -> DB : PUBLISHED hoặc REJECTED
end
Java --> Web : Trạng thái cuối
return Hoàn tất tương tác
@enduml
