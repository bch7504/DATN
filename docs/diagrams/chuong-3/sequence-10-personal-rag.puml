@startuml
' Palette: sequence; monochrome Visual Paradigm-style interaction.
' Monochrome: true
' Interaction: Trợ lý tài liệu cá nhân
' InteractionFrame: none
' ActivationPolicy: full
' Split PNG height: 7638
skinparam defaultFontColor #000000
skinparam ArrowColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ControlBackgroundColor #FFFFFF
skinparam ControlBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam LifeLineBackgroundColor #FFFFFF
skinparam LifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceLifeLineBorderColor #000000
skinparam sequence {
  LifeLineBackgroundColor #FFFFFF
  LifeLineBorderColor #000000
}
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #000000
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 26
skinparam roundcorner 0
hide footbox
autonumber

actor Student
boundary "«view»\n:PersonalDocumentsView" as DocumentsPage
boundary "«view»\n:PersonalAssistantView" as AssistantPanel
boundary "«view»\n:CitationView" as CitationPanel
boundary "«view»\n:QuizDraftReviewView" as QuizReview
control "PersonalAssistantDAO" as Controller
control "ConversationDAO" as Service
control "ConversationScopeDAO" as ScopeService
control "AiGatewayDAO" as AiClient
control "OrchestratorDAO" as Agent
control "AskDocumentDAO" as AskTool
control "SummarizeDocumentDAO" as SummaryTool
control "GenerateQuizDAO" as QuizTool
control "DocumentIndexDAO" as Retriever
control "GroundingValidationDAO" as Validator
entity ":PersonalDocument" as Document
entity ":ChatConversation" as Conversation
entity ":DocumentIndex" as Index
entity ":DocumentChunk" as Chunk
entity ":ChatMessage" as Message
entity ":AgentRun" as Run
boundary "«external system»\nModel Provider" as Model

activate Student
activate DocumentsPage
Student ->> DocumentsPage : selectDocuments(ids)
Student ->> DocumentsPage : openAssistant()
DocumentsPage -> AssistantPanel ++ : open(ids)
AssistantPanel --> DocumentsPage -- : void - đã mở hội thoại
deactivate DocumentsPage
Student ->> AssistantPanel ++ : submitPrompt(message)
AssistantPanel -> Controller ++ : postMessage(conversationId, MessageRequest)
Controller -> Service ++ : run(studentId, conversationId, request)
Service -> ScopeService ++ : loadAuthorizedSnapshot(studentId, conversationId)
ScopeService -> Conversation ++ : đọc hội thoại thuộc Student
Conversation --> ScopeService -- : ConversationSnapshot
loop Mỗi tài liệu đã chọn
ScopeService -> Document ++ : đọc owner, READY và version
Document --> ScopeService -- : DocumentSnapshot
end
ScopeService --> Service -- : AuthorizedScope hoặc lỗi truy cập
alt Phạm vi không hợp lệ
note right of Service
Đặt kết quả lỗi; không gọi AI.
end note
else Phạm vi hợp lệ
Service -> AiClient ++ : runAssistant(InternalAssistantRequest)
AiClient -> Agent ++ : run(request)
Agent -> Agent ++ : selectTool(message)
Agent --> Agent -- : ToolName
Agent -> Run ++ : ghi selectedTool và RUNNING
Run --> Agent -- : đã lưu AgentRun
alt Ý định chưa rõ
note right of Agent
Đặt kết quả NEEDS_CLARIFICATION
và câu hỏi làm rõ ý định.
end note
else Tool hỏi đáp
Agent -> AskTool ++ : execute(AskArgs, scope)
AskTool -> Retriever ++ : search(scope, query)
Retriever -> Index ++ : đọc chỉ mục theo document/version
Index --> Retriever -- : IndexSnapshot
Retriever -> Model ++ : embedding(query)
Model --> Retriever -- : QueryVector
Retriever -> Chunk ++ : tìm từ khóa + vector trong scope
Chunk --> Retriever -- : CandidateChunks
Retriever -> Model ++ : rerank(query, CandidateChunks)
Model --> Retriever -- : RankedEvidence
Retriever --> AskTool -- : EvidenceSet theo trang
alt Không đủ bằng chứng
note right of AskTool
Đặt kết quả NO_EVIDENCE.
Không gọi model sinh nội dung.
end note
else Có bằng chứng
AskTool -> Model ++ : sinh nội dung từ EvidenceSet
Model --> AskTool -- : AnswerResult
AskTool -> Validator ++ : validate(result, evidence)
Validator --> AskTool -- : ValidationResult
note right of AskTool
Nguồn hoặc cấu trúc không đạt: NO_EVIDENCE.
end note
end
AskTool --> Agent -- : ANSWERED hoặc NO_EVIDENCE
else Tool tóm tắt
Agent -> SummaryTool ++ : execute(SummaryArgs, scope)
SummaryTool -> Retriever ++ : search(scope, query)
Retriever -> Index ++ : đọc chỉ mục theo document/version
Index --> Retriever -- : IndexSnapshot
Retriever -> Model ++ : embedding(query)
Model --> Retriever -- : QueryVector
Retriever -> Chunk ++ : tìm từ khóa + vector trong scope
Chunk --> Retriever -- : CandidateChunks
Retriever -> Model ++ : rerank(query, CandidateChunks)
Model --> Retriever -- : RankedEvidence
Retriever --> SummaryTool -- : EvidenceSet theo trang
alt Không đủ bằng chứng
note right of SummaryTool
Đặt kết quả NO_EVIDENCE.
Không gọi model sinh nội dung.
end note
else Có bằng chứng
SummaryTool -> Model ++ : sinh nội dung từ EvidenceSet
Model --> SummaryTool -- : SummaryResult
SummaryTool -> Validator ++ : validate(result, evidence)
Validator --> SummaryTool -- : ValidationResult
note right of SummaryTool
Nguồn hoặc cấu trúc không đạt: NO_EVIDENCE.
end note
end
SummaryTool --> Agent -- : SUMMARIZED hoặc NO_EVIDENCE
else Tool tạo Quiz có nguồn
Agent -> QuizTool ++ : execute(QuizArgs, scope)
QuizTool -> Retriever ++ : search(scope, query)
Retriever -> Index ++ : đọc chỉ mục theo document/version
Index --> Retriever -- : IndexSnapshot
Retriever -> Model ++ : embedding(query)
Model --> Retriever -- : QueryVector
Retriever -> Chunk ++ : tìm từ khóa + vector trong scope
Chunk --> Retriever -- : CandidateChunks
Retriever -> Model ++ : rerank(query, CandidateChunks)
Model --> Retriever -- : RankedEvidence
Retriever --> QuizTool -- : EvidenceSet theo trang
alt Không đủ bằng chứng
note right of QuizTool
Đặt kết quả NO_EVIDENCE.
Không gọi model sinh nội dung.
end note
else Có bằng chứng
QuizTool -> Model ++ : sinh nội dung từ EvidenceSet
Model --> QuizTool -- : QuizDraft
QuizTool -> Validator ++ : validate(result, evidence)
Validator --> QuizTool -- : ValidationResult
note right of QuizTool
Nguồn hoặc cấu trúc không đạt: NO_EVIDENCE.
end note
end
QuizTool --> Agent -- : QUIZ_CREATED hoặc NO_EVIDENCE
end
Agent -> Run ++ : ghi kết quả thực hiện
Run --> Agent -- : đã lưu AgentRun
Agent --> AiClient -- : AssistantResponse
AiClient --> Service -- : AssistantResponse
Service -> ScopeService ++ : validateResult(scope, response)
ScopeService --> Service -- : void hoặc lỗi quyền/nguồn
alt Kết quả được Java chấp nhận
Service -> Message ++ : lưu hội thoại và liên kết Quiz nháp
Message --> Service -- : đã lưu ChatMessage
else Quyền hoặc nguồn không còn hợp lệ
note right of Service
Đặt kết quả lỗi; không lưu nội dung không hợp lệ.
end note
end
end
Service --> Controller -- : AssistantResponse hoặc lỗi theo contract
Controller --> AssistantPanel -- : AssistantResponse hoặc lỗi theo contract
AssistantPanel ->> Student : hiển thị kết quả hoặc câu hỏi làm rõ
opt Có citation và Student chọn xem nguồn
Student ->> AssistantPanel : chọn citation
AssistantPanel -> CitationPanel ++ : open(citation)
CitationPanel --> AssistantPanel -- : void - đã mở nguồn
end
opt Có QuizDraft hợp lệ
AssistantPanel -> QuizReview ++ : showDraft(response.quizDraft)
QuizReview --> AssistantPanel -- : void - đã hiển thị bản nháp
end
note right of Agent
Sơ đồ mô tả ba công cụ dùng PDF.
Nhập Quiz từ văn bản là luồng riêng, không truy xuất PDF.
end note
deactivate AssistantPanel
deactivate Student
@enduml
